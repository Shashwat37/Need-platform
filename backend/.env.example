# NEED Backend Configuration & Centralized API Keys Example Template
# Copy this file to ".env" and fill in production keys as needed.

# --- Secrets & Core ----------------------------------------------------
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///database.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Environment (development | production) ----------------------------
# Set to "production" on Render to enable HTTPS-only secure cookies
FLASK_ENV=development

# --- OTP Verification Settings ----------------------------------------
OTP_DEMO_MODE=true
DEFAULT_DEMO_OTP=123456
OTP_EXPIRY_MINUTES=10

# --- Mobile SMS OTP Gateway Keys (e.g. Twilio / MSG91 / Fast2SMS) ----
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_GATEWAY_URL=https://api.msg91.com/v5/otp
SMS_SENDER_ID=NEEDIN

# --- Email OTP & SMTP Service Settings (e.g. SendGrid / SMTP) -------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=support@need.in
SMTP_PASSWORD=your_email_app_password_here

# --- Aadhaar Govt Identity API Settings (e.g. Setu / Karza / Cashfree) -
AADHAAR_API_KEY=your_aadhaar_sandbox_api_key_here
AADHAAR_CLIENT_ID=your_aadhaar_client_id_here
AADHAAR_API_URL=https://api.sandbox.aadhaar.gov.in/v1/verify

# --- AI Chatbot & Demand Forecasting API Keys ------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
